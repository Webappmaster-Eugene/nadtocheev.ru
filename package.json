{
  "name": "visitka",
  "type": "module",
  "version": "1.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "build:test": "SITE_BUILD_DATE=2026-09-27 astro build",
    "check": "astro check",
    "test": "npm run test:unit && npm run build:test && npm run test:dist && npm run test:e2e",
    "test:unit": "vitest run --project unit",
    "test:dist": "vitest run --project dist",
    "test:nginx": "vitest run --project nginx",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "bash scripts/visual-docker.sh",
    "test:visual:update": "bash scripts/visual-docker.sh --update",
    "test:all": "npm run test && npm run test:nginx && npm run test:visual",
    "test:report": "playwright show-report",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.1",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^6.0.4",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "node-html-parser": "^9.0.4",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
