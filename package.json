{
  "name": "visitka",
  "type": "module",
  "version": "1.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "build:test": "PUBLIC_YANDEX_METRIKA_ID= PUBLIC_GA4_MEASUREMENT_ID= PUBLIC_YANDEX_VERIFICATION= PUBLIC_GOOGLE_SITE_VERIFICATION= PUBLIC_WEB_VITALS_DEBUG=false SITE_BUILD_DATE=2026-09-27 astro build",
    "check": "astro check",
    "test": "npm run test:unit && npm run build:test && npm run test:dist && npm run test:e2e",
    "test:unit": "vitest run --project unit",
    "test:dist": "vitest run --project dist",
    "test:nginx": "vitest run --project nginx",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "bash scripts/visual-docker.sh",
    "test:visual:update": "bash scripts/visual-docker.sh --update",
    "test:all": "npm run test && npm run test:nginx && npm run test:visual",
    "test:report": "playwright show-report",
    "check:links": "node scripts/check-links.mjs",
    "check:seo": "node scripts/audit-seo.mjs",
    "check:performance": "node scripts/lighthouse.mjs",
    "check:crux": "node scripts/crux.mjs",
    "codex": "node scripts/codex/harness.mjs launch",
    "codex:setup": "node scripts/codex/setup.mjs",
    "codex:sync": "node scripts/codex/harness.mjs sync",
    "codex:trust": "node scripts/codex/harness.mjs trust",
    "codex:doctor": "node scripts/codex/harness.mjs doctor",
    "codex:test": "node --test scripts/codex/*.test.mjs",
    "codex:verify": "node scripts/codex/harness.mjs verify",
    "codex:native-check": "node scripts/codex/native-check.mjs",
    "codex:mcp-check": "node scripts/codex/mcp.mjs probe",
    "codex:browser-check": "node scripts/codex/mcp.mjs browser-check",
    "codex:mcp-login": "node scripts/codex/oauth.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.1",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^6.0.4",
    "tailwindcss": "^4.2.1",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.63.0",
    "lighthouse": "^13.5.0",
    "node-html-parser": "^9.0.4",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
