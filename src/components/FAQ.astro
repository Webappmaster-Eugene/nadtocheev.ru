---
import { getFaq, type FaqItem } from "../data/faq.ts";
import { type Lang, t } from "../i18n/translations.ts";

interface Props { lang: Lang; items?: FaqItem[]; }
const { lang } = Astro.props;
const tr = t(lang);
const faq = Astro.props.items ?? getFaq(lang);

/** Разбивает ответ на текст и ссылки: URL в ответах FAQ становятся кликабельными */
const URL_RE = /(https?:\/\/[^\s),]*[^\s),.;:])/g; // без завершающей пунктуации предложения
const toParts = (text: string) =>
  text.split(URL_RE).filter(Boolean).map((part) => ({ text: part, isUrl: /^https?:\/\//.test(part) }));
---

<section id="faq" class="py-20 sm:py-24" aria-label={tr.faq.title}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal text-center">
      <h2 class="section-title"><span class="section-title-reveal">{tr.faq.title}</span></h2>
      <p class="section-subtitle">{tr.faq.subtitle}</p>
    </div>

    <div class="reveal mx-auto max-w-3xl space-y-2.5">
      {faq.map((item) => (
        <details class="card group !p-0">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-sm font-semibold sm:text-base [&::-webkit-details-marker]:hidden">
            <span>{item.q}</span>
            <svg class="h-4 w-4 shrink-0 text-text-dim transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="px-5 pb-5 text-sm leading-relaxed text-text-muted">
            {toParts(item.a).map((part) =>
              part.isUrl ? (
                <a href={part.text} target="_blank" rel="noopener noreferrer" class="text-accent-light underline decoration-accent-light/40 underline-offset-2 hover:decoration-accent-light">{part.text.replace(/^https?:\/\//, "").replace(/\/$/, "")}<span class="sr-only"> {tr.a11y.opensNewTab}</span></a>
              ) : (
                part.text
              )
            )}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
