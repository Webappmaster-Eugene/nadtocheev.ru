---
/**
 * Base layout - полное SEO (meta, OG, hreflang, JSON-LD Person),
 * шрифты, анимации, двуязычная поддержка.
 */
import "../styles/global.css";
import Metrics from "../components/Metrics.astro";
import { siteMetrics } from "../lib/metrics-config.ts";
import { personal } from "../data/personal.ts";
import { getFaq, type FaqItem } from "../data/faq.ts";
import { structuredData } from "../lib/structured-data.ts";
import { servicePath, type ServiceSlug } from "../data/service-pages.ts";
import { BUILD_DATE } from "../data/build-date.ts";
import { type Lang, t } from "../i18n/translations.ts";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  ogImage?: string;
  /** noindex + без canonical/hreflang (для 404) */
  noindex?: boolean;
  serviceSlug?: ServiceSlug;
  faqItems?: FaqItem[];
}

const { lang, noindex = false, serviceSlug } = Astro.props;

/** Дата сборки = дата последнего обновления контента (сайт статический, пересобирается при каждом деплое) */
const buildDate = BUILD_DATE;
const modifiedISO = buildDate.toISOString();
const tr = t(lang);

const title = Astro.props.title ?? tr.meta.title;
const description = Astro.props.description ?? tr.meta.description;
/** OG-картинка по языку: на EN имя латиницей (генерируются scripts/generate-icons.mjs) */
const ogImage = Astro.props.ogImage ?? (lang === "en" ? "/og-image-en.png" : "/og-image.png");
const ogImageURL = new URL(ogImage, Astro.site).href;

const canonicalURL = new URL(Astro.url.pathname.replace(/index\.html$/, "").replace(/\/en$/, "/en/"), Astro.site);
const ruURL = new URL(serviceSlug ? servicePath(serviceSlug, "ru") : "/", Astro.site);
const enURL = new URL(serviceSlug ? servicePath(serviceSlug, "en") : "/en/", Astro.site);

const faqItems = Astro.props.faqItems ?? getFaq(lang);
const jsonLd = structuredData({ lang, title, description, path: canonicalURL.pathname,
  image: ogImageURL, faq: faqItems, serviceSlug });
---

<!doctype html>
<html lang={tr.meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={personal.name.full[lang]} />
    <meta name="creator" content={personal.name.full[lang]} />
    <meta name="publisher" content={personal.name.full[lang]} />
    <meta name="copyright" content={`© ${buildDate.getFullYear()} ${personal.name.full[lang]}`} />

    <!-- Robots / индексация -->
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1" />
        <meta name="yandex" content="all" />
        <meta name="bingbot" content="index, follow" />
      </>
    )}

    {!noindex && (
      <>
        <link rel="canonical" href={canonicalURL} />

        <!-- hreflang - для мультиязычного SEO -->
        <link rel="alternate" hreflang="ru" href={ruURL} />
        <link rel="alternate" hreflang="en" href={enURL} />
        <link rel="alternate" hreflang="x-default" href={ruURL} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={serviceSlug || noindex ? "website" : "profile"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={lang === "ru"
      ? `${personal.name.full.ru} - Fullstack-разработчик`
      : `${personal.name.full.en} - Fullstack Developer`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={tr.meta.ogLocale} />
    <meta property="og:locale:alternate" content={lang === "ru" ? "en_US" : "ru_RU"} />
    <meta property="og:site_name" content={personal.name.full[lang]} />
    <meta property="profile:first_name" content={personal.name.first[lang]} />
    <meta property="profile:last_name" content={personal.name.last[lang]} />
    <meta property="profile:gender" content="male" />
    <meta property="profile:username" content="webappmaster" />
    <meta property="og:updated_time" content={modifiedISO} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={lang === "ru"
      ? `${personal.name.full.ru} - Fullstack-разработчик`
      : `${personal.name.full.en} - Fullstack Developer`} />
    <meta name="twitter:domain" content="nadtocheev.ru" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:label1" content={lang === "ru" ? "Должность" : "Job title"} />
    <meta name="twitter:data1" content={lang === "ru" ? "Fullstack-разработчик" : "Fullstack Developer"} />
    <meta name="twitter:label2" content={lang === "ru" ? "Локация" : "Location"} />
    <meta name="twitter:data2" content={lang === "ru" ? "Москва, удалённо" : "Moscow, remote"} />

    <!-- JSON-LD Structured Data -->
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Theme color -->
    <meta name="theme-color" content="#0a0a0b" id="meta-theme-color" />
    <meta name="color-scheme" content="dark light" />

    <!-- PWA + Apple Web App + Windows tiles -->
    <meta name="application-name" content={personal.name.full[lang]} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={personal.name.last[lang]} />
    <meta name="format-detection" content="telephone=yes, email=yes, address=no" />
    <meta name="HandheldFriendly" content="True" />
    <meta name="MobileOptimized" content="320" />
    <meta name="msapplication-TileImage" content="/favicon-512.png" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="msapplication-tap-highlight" content="no" />

    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      (function() {
        document.documentElement.classList.add("js");
        /* Сохранённая тема, иначе системная (prefers-color-scheme) */
        var theme = null;
        try { theme = localStorage.getItem("theme"); } catch (e) {}
        if (!theme) theme = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        if (theme === "light") {
          document.documentElement.classList.add("light");
          var m = document.getElementById("meta-theme-color");
          if (m) m.setAttribute("content", "#f8fafc");
        }
      })();
    </script>

    <!-- IndieWeb: rel="me" для связывания профилей -->
    <link rel="me" href={personal.telegram} />
    <link rel="me" href={personal.github} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileColor" content="#0a0a0b" />

    <!-- Self-hosted шрифты: Inter variable (latin + cyrillic) + JetBrains Mono -->
    <!-- @font-face декларации лежат в global.css. Латиница нужна обеим версиям (цифры, названия технологий),
         кириллица - основной текст RU; на EN она встречается точечно и грузится по unicode-range -->
    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    {lang === "ru" && <link rel="preload" href="/fonts/inter-cyrillic-var.woff2" as="font" type="font/woff2" crossorigin />}

    <!-- Public verification codes are configured at build time. -->
    {siteMetrics.yandexVerification && <meta name="yandex-verification" content={siteMetrics.yandexVerification} />}
    {siteMetrics.googleVerification && <meta name="google-site-verification" content={siteMetrics.googleVerification} />}

    <!-- llms.txt + AI discovery (GEO для LLM-движков) -->
    <link rel="llms.txt" href="/llms.txt" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly summary" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLM-friendly full profile" />
    <link rel="alternate" type="text/plain" href="/humans.txt" title="Humans of this site" />

    <!-- Telegram Instant View / Mini App / Channel reference -->
    <meta name="telegram:channel" content="@captain_galera" />
    <meta name="telegram:contact" content="@eugene_nadtocheev" />

  </head>

  <body class="min-h-screen bg-bg text-text antialiased">
    <a href="#main-content" class="skip-link">{tr.a11y.skipToContent}</a>
    <div id="scroll-progress" aria-hidden="true"></div>
    <slot />

    <!-- Scroll-triggered reveal animations -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        var targets = document.querySelectorAll(".reveal, .stagger-children");
        if (!targets.length) return;
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -60px 0px" }
        );
        targets.forEach(function (el) { observer.observe(el); });
      });
    </script>

    <!-- Анимированные счётчики (.counter[data-target]: "5", "200K+", "30+") во всех секциях -->
    <script is:inline>
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var counters = document.querySelectorAll(".counter[data-target]");
        if (!counters.length) return;
        function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }
        function animate(el) {
          var raw = el.getAttribute("data-target") || "";
          var match = raw.match(/^(\d+)(.*)$/);
          if (!match) return;
          var target = parseInt(match[1], 10);
          var suffix = match[2];
          var start = performance.now();
          function step(now) {
            var progress = Math.min((now - start) / 1500, 1);
            el.textContent = Math.round(easeOutCubic(progress) * target) + suffix;
            if (progress < 1) requestAnimationFrame(step);
          }
          el.textContent = "0" + suffix;
          requestAnimationFrame(step);
        }
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              animate(entry.target);
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.3 });
        counters.forEach(function (el) { observer.observe(el); });
      })();
    </script>

    <!-- Scroll progress bar -->
    <script is:inline>
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var bar = document.getElementById("scroll-progress");
        if (!bar) return;
        window.addEventListener("scroll", function () {
          var scrollTop = window.scrollY;
          var docHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (docHeight > 0) {
            bar.style.width = (scrollTop / docHeight * 100) + "%";
          }
        }, { passive: true });
      })();
    </script>

    <!-- Button ripple effect -->
    <script is:inline>
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        document.addEventListener("click", function (e) {
          var btn = e.target.closest(".btn-ripple");
          if (!btn) return;
          var rect = btn.getBoundingClientRect();
          var ripple = document.createElement("span");
          ripple.className = "ripple";
          ripple.style.left = (e.clientX - rect.left) + "px";
          ripple.style.top = (e.clientY - rect.top) + "px";
          btn.appendChild(ripple);
          ripple.addEventListener("animationend", function () {
            ripple.remove();
          });
        });
      })();
    </script>

    <!-- Section anchor links + back-to-top -->
    <button id="back-to-top" class="back-to-top" type="button" aria-label={lang === "ru" ? "Наверх" : "Back to top"} title={lang === "ru" ? "Наверх" : "Back to top"}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5" />
        <path d="M5 12l7-7 7 7" />
      </svg>
    </button>

    <script is:inline define:vars={{ anchorAria: lang === "ru" ? "Скопировать ссылку на раздел" : "Copy link to section" }}>
      document.addEventListener("DOMContentLoaded", function () {
        /* Section anchor # buttons */
        document.querySelectorAll("section[id]").forEach(function (section) {
          var id = section.id;
          if (!id || id === "hero") return;
          var h2 = section.querySelector("h2.section-title");
          if (!h2 || h2.querySelector(".section-anchor")) return;
          var a = document.createElement("a");
          a.href = "#" + id;
          a.className = "section-anchor";
          a.textContent = "#";
          a.setAttribute("aria-label", anchorAria + ": " + h2.textContent.trim());
          a.addEventListener("click", function () {
            if (navigator.clipboard && window.location && window.location.href) {
              var url = window.location.origin + window.location.pathname + "#" + id;
              navigator.clipboard.writeText(url).then(function () {
                a.classList.add("copied");
                setTimeout(function () { a.classList.remove("copied"); }, 1500);
              }).catch(function () {});
            }
          });
          h2.appendChild(a);
        });

        /* Back-to-top button */
        var btn = document.getElementById("back-to-top");
        if (!btn) return;
        var threshold = 600;
        var update = function () {
          if (window.scrollY > threshold) btn.classList.add("visible");
          else btn.classList.remove("visible");
        };
        window.addEventListener("scroll", update, { passive: true });
        update();
        btn.addEventListener("click", function () {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      });
    </script>
    {!noindex && <Metrics />}
  </body>
</html>
